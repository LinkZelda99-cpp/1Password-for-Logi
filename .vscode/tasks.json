{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Debug",
      "type": "shell",
      "command": "dotnet build ./OnePasswordPlugin.slnx --configuration Debug",
      "options": {
        "cwd": "${workspaceFolder}/OnePasswordPlugin"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build: Release",
      "type": "shell",
      "command": "dotnet build ./OnePasswordPlugin.slnx --configuration Release",
      "options": {
        "cwd": "${workspaceFolder}/OnePasswordPlugin"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Package: Plugin",
      "type": "shell",
      "command": "logiplugintool pack ./bin/Release ./OnePasswordForLogi_0_1_0.lplug4",
      "options": {
        "cwd": "${workspaceFolder}/OnePasswordPlugin"
      },
      "dependsOn": "Build: Release",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Verify: Plugin Package",
      "type": "shell",
      "command": "logiplugintool verify ./OnePasswordForLogi_0_1_0.lplug4",
      "options": {
        "cwd": "${workspaceFolder}/OnePasswordPlugin"
      },
      "dependsOn": "Package: Plugin",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Install: Plugin",
      "type": "shell",
      "command": "logiplugintool install ./OnePasswordForLogi_0_1_0.lplug4",
      "options": {
        "cwd": "${workspaceFolder}/OnePasswordPlugin"
      },
      "dependsOn": "Verify: Plugin Package",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Uninstall: Legacy Starter",
      "type": "shell",
      "command": "logiplugintool uninstall OnePassword",
      "options": {
        "cwd": "${workspaceFolder}/OnePasswordPlugin"
      },
      "problemMatcher": []
    },
    {
      "label": "Uninstall: Plugin",
      "type": "shell",
      "command": "logiplugintool uninstall OnePasswordForLogi",
      "options": {
        "cwd": "${workspaceFolder}/OnePasswordPlugin"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean: Release Build",
      "type": "shell",
      "command": "dotnet clean ./OnePasswordPlugin.slnx --configuration Release",
      "options": {
        "cwd": "${workspaceFolder}/OnePasswordPlugin"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Clean + Package + Verify",
      "type": "shell",
      "command": "dotnet clean ./OnePasswordPlugin.slnx --configuration Release && dotnet build ./OnePasswordPlugin.slnx --configuration Release && logiplugintool pack ./bin/Release ./OnePasswordForLogi_0_1_0.lplug4 && logiplugintool verify ./OnePasswordForLogi_0_1_0.lplug4",
      "options": {
        "cwd": "${workspaceFolder}/OnePasswordPlugin"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
